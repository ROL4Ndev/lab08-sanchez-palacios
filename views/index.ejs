<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Control de Pacientes - Clinica</title>
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f4f9; padding: 30px; display: flex; flex-direction: column; align-items: center; }
    .card { background: white; padding: 25px 35px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); width: 700px; margin-bottom: 20px; }
    h2, h3 { color: #333; margin-top: 0; text-align: center; }
    .kpi-card { background-color: #007bff; color: white; padding: 15px; border-radius: 8px; text-align: center; font-size: 1.2em; font-weight: bold; margin-bottom: 20px; }
    .menu { display: flex; justify-content: space-around; background: #e0e0e0; border-radius: 8px; padding: 10px; margin-bottom: 20px; }
    .menu a { text-decoration: none; color: #333; font-weight: bold; padding: 8px 12px; border-radius: 5px; }
    .menu a:hover { background-color: #007bff; color: white; }
    form { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .form-group { display: flex; flex-direction: column; }
    .form-group-full { grid-column: span 2; display: flex; flex-direction: column; }
    label { font-weight: bold; margin-bottom: 5px; color: #555; }
    input[type="text"], input[type="number"] { padding: 8px; border: 1px solid #ccc; border-radius: 5px; }
    button { background-color: #28a745; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; font-size: 16px; margin-top: 10px; }
    button:hover { background-color: #218838; }
    .btn-edit { background-color: #ffc107; color: #333; text-decoration: none; padding: 5px 10px; border-radius: 4px; font-size: 13px; }
    .btn-delete { background-color: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 13px; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
    th { background-color: #007bff; color: white; }
    tr:nth-child(even) { background-color: #f9f9f9; }
    .gratis-row { background-color: #ffe6e6 !important; color: #d9534f; }
    .badge-alerta { background-color: #dc3545; color: white; padding: 3px 6px; border-radius: 4px; font-size: 0.8em; font-weight: bold; margin-left: 5px; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Gestion de Pacientes (Clinica)</h2>

    <div class="kpi-card">
      Recaudacion Total Consultas: S/. <%= recaudacionTotal.toLocaleString() %>
    </div>

    <div class="menu">
      <a href="#seccion-form">Registrar o Editar</a>
      <a href="#seccion-filtro">Consultar</a>
      <a href="/">Ver Todo</a>
    </div>

    <div id="seccion-filtro" style="margin-bottom: 25px; background: #f8f9fa; padding: 15px; border-radius: 8px;">
      <h3>Busqueda de Pacientes</h3>
      <form action="/" method="GET" style="grid-template-columns: 1fr auto;">
        <input type="text" name="busqueda" placeholder="Buscar por nombre..." value="<%= busqueda %>">
        <button type="submit" style="background-color: #007bff; margin-top: 0;">Buscar</button>
      </form>
    </div>

    <div id="seccion-form">
      <h3><%= pacienteEditar ? 'Modificar Paciente' : 'Registrar Paciente' %></h3>
      
      <form action="<%= pacienteEditar ? '/editar/' + pacienteEditar._id : '/crear' %>" method="POST">
        <div class="form-group">
          <label>Nombre del Paciente:</label>
          <input type="text" name="nombre" value="<%= pacienteEditar ? pacienteEditar.nombre : '' %>" required>
        </div>
        <div class="form-group">
          <label>Especialidad Medica:</label>
          <input type="text" name="especialidad" value="<%= pacienteEditar ? pacienteEditar.especialidad : '' %>" required>
        </div>
        <div class="form-group">
          <label>Costo de Consulta (S/.):</label>
          <input type="number" step="0.01" name="costo" value="<%= pacienteEditar ? pacienteEditar.costo : '' %>" required>
        </div>
        <div class="form-group">
          <label>Edad:</label>
          <input type="number" name="edad" value="<%= pacienteEditar ? pacienteEditar.edad : '' %>" required>
        </div>
        <div class="form-group-full">
          <button type="submit" style="background-color: <%= pacienteEditar ? '#ffc107' : '#28a745' %>; color: <%= pacienteEditar ? '#333' : 'white' %>;">
            <%= pacienteEditar ? 'Guardar Cambios' : 'Registrar Paciente' %>
          </button>
          <% if (pacienteEditar) { %>
            <a href="/" style="text-align: center; display: block; margin-top: 10px; color: #6c757d; text-decoration: none;">Cancelar Edicion</a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <h3>Lista de Pacientes</h3>
    <table>
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Especialidad</th>
          <th>Edad</th>
          <th>Costo Consulta</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (pacientes.length === 0) { %>
          <tr>
            <td colspan="5" style="text-align: center;">No hay pacientes registrados.</td>
          </tr>
        <% } else { %>
          <% pacientes.forEach(p => { %>
            <tr class="<%= p.costo === 0 ? 'gratis-row' : '' %>">
              <td><%= p.nombre %></td>
              <td><%= p.especialidad %></td>
              <td><%= p.edad %> anos</td>
              <td>
                S/. <%= p.costo %>
                <% if (p.costo === 0) { %>
                  <span class="badge-alerta">CONSULTA GRATUITA</span>
                <% } %>
              </td>
              <td style="display: flex; gap: 5px;">
                <a href="/?editId=<%= p._id %>#seccion-form" class="btn-edit">Editar</a>
                <form action="/eliminar/<%= p._id %>" method="POST" onsubmit="return confirm('Desea eliminar este paciente?');" style="display:inline;">
                  <button type="submit" class="btn-delete">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>